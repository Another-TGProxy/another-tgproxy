<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Another TGProxy</name>
  <summary>MTProto to WebSocket bridge proxy for Telegram</summary>
  <description>
    <p>
      A native MTProto proxy for Telegram that bridges the obfuscated MTProto
      transport to a WebSocket (WSS) connection to the Telegram data centres,
      with Cloudflare-proxy and fake-TLS fallbacks. Runs as a background daemon
      controlled by a GTK4/libadwaita front-end.
    </p>
  </description>
  <developer id="space.ampernic">
    <name>Ampernic</name>
  </developer>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <categories>
    <category>Network</category>
  </categories>
  <keywords>
    <keyword>Telegram</keyword>
    <keyword>proxy</keyword>
    <keyword>MTProto</keyword>
    <keyword>WebSocket</keyword>
  </keywords>
  <url type="homepage">https://github.com/Another-TGProxy</url>
  <url type="bugtracker">https://github.com/Another-TGProxy/another-tgproxy/issues</url>
  <url type="vcs-browser">https://github.com/Another-TGProxy/another-tgproxy</url>
  <releases>
    <release version="2.0.0" date="2026-06-02"/>
  </releases>
  <content_rating type="oars-1.1"/>
  <recommends>
    <id>space.ampernic.AnotherTGProxy.Extension</id>
  </recommends>
</component>
