<?xml version="1.0" encoding="UTF-8"?>
<!-- Static AppStream metadata for the Android build. Pixiewood reads it to derive
     the package id, version code and permissions; the <requires><internet/> here
     is what makes generate add INTERNET + ACCESS_NETWORK_STATE to the manifest
     (the proxy connects out over wss://). The desktop build uses the templated
     metainfo under data/ instead. -->
<component type="desktop-application" xmlns="https://specifications.freedesktop.org/metainfo/1.0">
  <id>space.ampernic.AnotherTGProxy</id>
  <name>Another TGProxy</name>
  <summary>MTProto-over-WebSocket Telegram proxy</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>A Telegram MTProto proxy that bridges to backends over secure WebSocket,
       running entirely on-device in a single process.</p>
  </description>
  <launchable type="desktop-id">space.ampernic.AnotherTGProxy.desktop</launchable>
  <requires>
    <internet bandwidth_mbitps="1">always</internet>
  </requires>
  <!-- version/date are stamped by CI (android.yml) from the build version, since
       Pixiewood derives the APK versionName from this; not hardcoded. -->
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
