<?xml version="1.0" encoding="UTF-8"?>
<!-- Pixiewood manifest for the real app. Run from the GUI repo root (where
     meson.build lives), so src:// paths are relative to that root. json-glib and
     the mtproxy-ws core are pulled as ordinary meson subproject wraps (see
     subprojects/); OpenSSL for the core is staged into the NDK sysroot by CI. -->
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
	<metainfo vercalc="count">
		<xi:include href="src://packaging/android/app/space.ampernic.AnotherTGProxy.metainfo.xml" parse="xml"/>
	</metainfo>
	<style>
		<theme name="adw"/>
		<icon type="generate">
			<drawable target="foreground" type="avd" path="src://packaging/android/app/foreground.xml"/>
			<color target="background">#1C71D8</color>
		</icon>
	</style>
	<dependencies>
		<glib>
			<patch>hack</patch>
		</glib>
		<!-- glib hard-requires iconv; Bionic only has it from API 28, so for our
		     minSdk-26 build provide GNU libiconv (wrap injected in android.yml). -->
		<iconv/>
		<fontconfig/>
		<gtk>
			<!-- Make gdk-android run on Android 8+ (API 26): the backend hard-calls
			     API-31 input, API-29 choreographer and API-30 window-insets/IME APIs,
			     fetches the clipboard manager from a not-yet-bound activity context, and
			     link-references Vulkan 1.1 symbols absent before API 28; these patches add
			     pre-31/30/29/28 fallbacks and lazy clipboard init. gtk.wrap is pinned
			     (in android.yml) to the commit they apply against. -->
			<patch>android-input-jni</patch>
			<patch>android-choreographer-fallback</patch>
			<patch>android-clipboard-lazy-manager</patch>
			<patch>android-window-insets-pre30</patch>
			<patch>android-vulkan-procaddr-pre28</patch>
		</gtk>
		<libadwaita/>
	</dependencies>
	<build target="another-tgproxy">
		<configure-options>
			<!-- json-glib otherwise pulls the gobject-introspection subproject,
			     which needs a (cross-unusable) Python.h. We don't need GIR. -->
			<option>-Djson-glib:introspection=disabled</option>
			<option>-Djson-glib:tests=false</option>
			<!-- Link libiconv into libglib statically so no extra .so must be bundled. -->
			<option>-Diconv:default_library=static</option>
			<!-- gdk-pixbuf's Android ImageDecoder loader needs API 30/31; disable it for
			     our minSdk-26 build. SVG icons load via the rsvg loader, raster via GTK4. -->
			<option>-Dgdk-pixbuf:android=disabled</option>
			<!-- Vulkan renderer stays ENABLED: the android-vulkan-procaddr-pre28 patch
			     resolves the Vulkan 1.1 entry points via vkGetInstanceProcAddr so the
			     minSdk-26 build links, runs Vulkan on API 28+ and falls back to GL on
			     1.0 loaders (API 26-27). Needs glslc at build time (installed in CI). -->
			<option>-Dgtk:vulkan=enabled</option>
		</configure-options>
		<architectures>
			<arch>aarch64</arch>
			<arch>x86_64</arch>
		</architectures>
	</build>
</app>
