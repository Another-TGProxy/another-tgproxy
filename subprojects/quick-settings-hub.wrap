# libqshub: a GNOME Quick Settings client, built from source as a subproject so
# bundled builds ship it. Carries a committed vapi (via the vapidir dep variable);
# the app just depends on qshub-1 and valac picks up qshub-1.vapi. On ALT a system
# package would be found first and this fallback is unused. Pinned to a commit.
[wrap-git]
url = https://altlinux.space/ampernic/quick-settings-hub.git
revision = 9bbbf999418c0cb95fb769b8c287626c471b8d7d

[provide]
qshub-1 = qshub_dep
