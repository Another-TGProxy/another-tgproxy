# The C proxy engine. On desktop the GUI builds against the installed mtproxy-ws
# package (pkg-config); this wrap is the fallback for builds with no system core —
# notably the Android cross build, where the engine is compiled in-tree and the
# whole app is one process. The core's meson.build calls override_dependency() and
# exposes its vapidir, so dependency('mtproxy-ws', fallback: [...]) resolves here.
[wrap-git]
url = https://github.com/Another-TGProxy/mtproxy-ws.git
revision = main
depth = 1

[provide]
mtproxy-ws = mtproxyws_dep
