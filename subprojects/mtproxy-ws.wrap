# The C proxy engine, vendored as a meson subproject and built from source in
# every bundled build (AppImage, Windows, macOS, Android, Flatpak) — none of
# those platforms ship a system mtproxy-ws. The ALT build is the exception: it
# BuildRequires libmtproxyws-devel, so pkg-config finds the system package first
# and this fallback is never used (hasher has no network and still builds fine).
#
# revision is pinned to an exact commit so a GUI tag builds one deterministic
# core on every platform. Bump it deliberately via tools/pin-deps.sh.
[wrap-git]
url = https://github.com/Another-TGProxy/mtproxy-ws.git
revision = 4b2f68d3ebcc73be6b19ee03d5ad724a0e873980

[provide]
mtproxy-ws = mtproxyws_dep
